# Copy to .env for local development. In staging/production load these from a managed secrets store
# (AWS Secrets Manager / SSM). NEVER commit real values.
ENV=development
DATABASE_URL=postgresql+psycopg://servixe:servixe@localhost:5432/servixe
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=generate-a-long-random-string
PAYMENT_WEBHOOK_SECRET=generate-a-long-random-string
WHATSAPP_WEBHOOK_SECRET=generate-a-long-random-string
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-string

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false            # true in staging/production (HTTPS)
REQUIRE_EMAIL_VERIFICATION=false

STORAGE_BACKEND=local          # s3 in staging/production (private bucket, SSE enabled, no public access)
S3_BUCKET=servixe-private
S3_REGION=ap-south-1

EMAIL_BACKEND=console          # ses
WHATSAPP_BACKEND=console       # cloud_api
PAYMENT_GATEWAY=stub           # replace after India/overseas payment review
TURNSTILE_SECRET=              # Cloudflare Turnstile secret (empty = skipped, dev only)
CELERY_EAGER=true              # false when a Celery worker is running
SENTRY_DSN=

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Now-123
